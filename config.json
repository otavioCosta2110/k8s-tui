{
  "theme": "catppuccin-mocha",
  "refresh_interval_seconds": 10,
  "auto_refresh": true,
  "default_namespace": "default",
  "plugin_dir": "~/.local/share/k8s-tui/plugins/",
  "key_bindings": {
    "back": "[",
    "close_tab": "x",
    "forward": "]",
    "help": "?",
    "new_tab": "t",
    "quick_nav": "g",
    "quit": "q",
    "refresh": "r",
    "ctrl+s": "session:save"
  }
}
